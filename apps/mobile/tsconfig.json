{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@couragegang/shared": ["../../packages/shared/src"],
      "@couragegang/shared/*": ["../../packages/shared/src/*"],
      "@couragegang/api-client": ["../../packages/api-client/src"],
      "@couragegang/design-system": ["../../packages/design-system/src"],
      "@couragegang/app-ui": ["../../packages/app-ui/src"],
      "@couragegang/app-ui/*": ["../../packages/app-ui/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
